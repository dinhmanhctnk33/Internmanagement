<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Quản lý hợp đồng - IMS</title><link rel="stylesheet" href="${pageContext.request.contextPath}/frontend/css/dashboard.css?v=20261008-2"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
<style>
.content{max-width:1500px;margin:0 auto}.contract-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:24px}.contract-heading h1{margin:0 0 7px;font-size:30px;color:var(--primary-dark)}.contract-heading p{margin:0;color:var(--text-muted)}
.summary-grid{display:grid;grid-template-columns:repeat(3,minmax(180px,1fr));gap:16px;margin-bottom:20px}.summary-card{display:flex;align-items:center;gap:14px;padding:18px 20px;background:#fff;border:1px solid var(--border-color);border-radius:12px;box-shadow:0 3px 12px rgba(30,64,106,.06)}.summary-icon{display:grid;place-items:center;width:43px;height:43px;border-radius:10px;background:#eaf2fc;color:#275b91;font-size:18px}.summary-card.warning .summary-icon{background:#fff3da;color:#b26a00}.summary-card.success .summary-icon{background:#e8f8ef;color:#18794e}.summary-card small{display:block;color:var(--text-muted);font-size:12px;margin-bottom:3px}.summary-card strong{font-size:23px;color:var(--primary-dark)}
.upload-panel{padding:22px 26px;margin-bottom:20px}.panel-title{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px}.panel-title h2{margin:0;font-size:19px;color:var(--primary-dark)}.panel-title p{margin:4px 0 0;color:var(--text-muted);font-size:13px}.upload-form{display:grid;grid-template-columns:1.45fr .95fr .75fr .75fr 1.25fr auto;gap:14px;align-items:end}.field{display:grid;gap:7px;min-width:0}.field span{font-size:12px;font-weight:750;color:#304e72}.field input,.field select{height:44px;width:100%;padding:0 12px;border:1px solid #cad7e6;border-radius:8px;background:#fff;font:inherit;color:#17365d}.field input:focus,.field select:focus{outline:0;border-color:#356da8;box-shadow:0 0 0 3px rgba(53,109,168,.12)}.file-control{position:relative;display:flex;align-items:center;height:44px;padding:0 10px;border:1px dashed #9eb4cd;border-radius:8px;background:#f8fbff;overflow:hidden}.file-control input{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:pointer}.file-control span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#58718f;font-weight:500}.submit-contract{height:44px;white-space:nowrap;padding:0 18px}
.list-card{overflow:hidden}.list-head{display:flex;align-items:center;justify-content:space-between;padding:20px 24px 16px}.list-head h2{margin:0;font-size:19px;color:var(--primary-dark)}.list-head span{font-size:12px;color:var(--text-muted);background:#eef3f8;padding:6px 10px;border-radius:999px}.contract-table{table-layout:fixed}.contract-table th{font-size:11px;letter-spacing:.04em}.contract-table th:nth-child(1){width:30%}.contract-table th:nth-child(2){width:16%}.contract-table th:nth-child(3){width:16%}.contract-table th:nth-child(4){width:21%}.contract-table th:nth-child(5){width:17%}.contract-table td{height:72px;vertical-align:middle}.contract-table td.person{display:table-cell}.contract-table .person strong{display:block;color:#17365d}.contract-table .person small,.period small{display:block;color:var(--text-muted);margin-top:4px}.contract-number{font-weight:700;color:#244d7d}.status-pill{display:inline-flex;align-items:center;gap:6px;padding:6px 10px;border-radius:999px;font-size:12px;font-weight:700}.status-pill.pending{background:#fff3d6;color:#9b6100}.status-pill.signed{background:#e6f7ed;color:#18794e}.pdf-link{display:inline-flex;align-items:center;gap:7px;padding:8px 11px;border:1px solid #9fb4cc;border-radius:7px;color:#285786;text-decoration:none;font-weight:700;font-size:12px}.pdf-link:hover{background:#edf4fc}.alert{padding:13px 16px;margin-bottom:18px;border-radius:9px;background:#edf9f2;border:1px solid #b7e4c7;color:#18794e}.alert.error{background:#fff1f1;border-color:#efc1c1;color:#a61b1b}
@media(max-width:1280px){.upload-form{grid-template-columns:1.4fr 1fr 1fr 1fr}.field.file-field{grid-column:span 3}.submit-contract{grid-column:4}}@media(max-width:850px){.summary-grid{grid-template-columns:1fr}.upload-form{grid-template-columns:1fr 1fr}.field.file-field{grid-column:span 2}.submit-contract{grid-column:span 2}.table-container{overflow:auto}.contract-heading{align-items:flex-start;flex-direction:column}}
</style></head>
<body><div class="layout"><aside class="sidebar"><div class="logo"><div class="logo-icon"><i class="fa-solid fa-user-tie"></i></div><div><h2>IMS Portal</h2><span>Phòng Nhân sự (HR)</span></div></div><nav class="menu"><p class="menu-title">NGHIỆP VỤ HR</p><a href="${pageContext.request.contextPath}/home" class="menu-item"><i class="fa-solid fa-chart-line"></i><span>Dashboard HR</span></a><a href="${pageContext.request.contextPath}/applications" class="menu-item"><i class="fa-solid fa-user-check"></i><span>Kết quả ứng viên</span></a><a href="${pageContext.request.contextPath}/contracts" class="menu-item active"><i class="fa-solid fa-file-contract"></i><span>Hợp đồng thực tập</span></a></nav><div class="sidebar-bottom"><a href="${pageContext.request.contextPath}/logout" class="menu-item logout"><i class="fa-solid fa-right-from-bracket"></i><span>Đăng xuất</span></a></div></aside>
<main class="main"><header class="header"></header><section class="content"><div class="contract-heading"><div><h1>Hợp đồng thực tập</h1><p>Tải lên, gửi và theo dõi hợp đồng của thực tập sinh tại một nơi.</p></div></div>
<c:if test="${param.uploaded=='1'}"><div class="alert"><i class="fa-solid fa-circle-check"></i> Đã tải lên và gửi hợp đồng cho thực tập sinh.</div></c:if><c:if test="${not empty error}"><div class="alert error"><i class="fa-solid fa-circle-exclamation"></i> <c:out value="${error}"/></div></c:if>
<div class="summary-grid"><article class="summary-card"><span class="summary-icon"><i class="fa-solid fa-users"></i></span><div><small>Thực tập sinh đang hoạt động</small><strong>${totalInterns}</strong></div></article><article class="summary-card warning"><span class="summary-icon"><i class="fa-regular fa-clock"></i></span><div><small>Hợp đồng chờ xác nhận</small><strong>${pendingContracts}</strong></div></article><article class="summary-card success"><span class="summary-icon"><i class="fa-solid fa-circle-check"></i></span><div><small>Hợp đồng đã xác nhận</small><strong>${signedContracts}</strong></div></article></div>
<section class="card upload-panel"><div class="panel-title"><div><h2>Tải hợp đồng mới</h2><p>Điền thông tin và chọn tệp PDF để gửi cho thực tập sinh.</p></div><span class="badge pending">PDF · tối đa 10 MB</span></div><form method="post" enctype="multipart/form-data" class="upload-form"><label class="field"><span>Thực tập sinh *</span><select name="profileId" required><option value="">Chọn thực tập sinh</option><c:forEach items="${interns}" var="i"><option value="${i.id}"><c:out value="${i.full_name}"/> · <c:out value="${i.intern_code}"/></option></c:forEach></select></label><label class="field"><span>Số hợp đồng *</span><input name="contractNumber" required placeholder="HDTT-2026-001"></label><label class="field"><span>Ngày bắt đầu *</span><input type="date" name="effectiveDate" required></label><label class="field"><span>Ngày kết thúc *</span><input type="date" name="expirationDate" required></label><label class="field file-field"><span>Tệp hợp đồng *</span><span class="file-control"><input id="contractFile" type="file" name="contractFile" accept="application/pdf" required onchange="document.getElementById('fileName').textContent=this.files[0]?this.files[0].name:'Chọn tệp PDF'"><span id="fileName"><i class="fa-solid fa-cloud-arrow-up"></i> Chọn tệp PDF</span></span></label><button class="primary-btn submit-contract"><i class="fa-solid fa-paper-plane"></i> Tải lên &amp; gửi</button></form></section>
<section class="card list-card"><div class="list-head"><h2>Danh sách hợp đồng</h2><span>${contracts.size()} hợp đồng</span></div><div class="table-container"><table class="contract-table"><thead><tr><th>THỰC TẬP SINH</th><th>SỐ HỢP ĐỒNG</th><th>THỜI GIAN</th><th>TRẠNG THÁI</th><th>TỆP</th></tr></thead><tbody><c:forEach items="${contracts}" var="c"><tr><td class="person"><strong><c:out value="${c.full_name}"/></strong><small><c:out value="${c.intern_code}"/><c:if test="${not empty c.program_name}"> · <c:out value="${c.program_name}"/></c:if></small></td><td class="contract-number"><c:out value="${c.contract_number}"/></td><td class="period">${c.effective_date}<small>đến ${c.expiration_date}</small></td><td><span class="status-pill ${c.signature_status=='SIGNED'?'signed':'pending'}"><i class="fa-solid ${c.signature_status=='SIGNED'?'fa-check':'fa-clock'}"></i>${c.signature_status=='SIGNED'?'Đã xác nhận':'Chờ xác nhận'}</span></td><td><a class="pdf-link" target="_blank" href="${pageContext.request.contextPath}${c.contract_pdf_url}"><i class="fa-regular fa-file-pdf"></i> Xem PDF</a></td></tr></c:forEach><c:if test="${empty contracts}"><tr><td colspan="5" style="padding:48px;text-align:center;color:var(--text-muted)"><i class="fa-regular fa-folder-open" style="font-size:26px;margin-bottom:10px"></i><br>Chưa có hợp đồng nào.</td></tr></c:if></tbody></table></div></section></section></main></div></body></html>
