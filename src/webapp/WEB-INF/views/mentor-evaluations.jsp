<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Đánh giá tổng kết - Mentor</title><link rel="stylesheet" href="${pageContext.request.contextPath}/frontend/css/dashboard.css?v=20261012-3"><link rel="stylesheet" href="${pageContext.request.contextPath}/frontend/css/intern-header.css?v=20261010-2"><link rel="stylesheet" href="${pageContext.request.contextPath}/frontend/css/mentor-workspace.css?v=20261012-2"><link rel="stylesheet" href="${pageContext.request.contextPath}/frontend/css/mentor-evaluations.css?v=20261013-1"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head>
<body><div class="layout"><aside class="sidebar mentor-sidebar"><div class="logo"><div class="logo-icon"><i class="fa-solid fa-chalkboard-user"></i></div><div><h2>IMS Portal</h2><span>Không gian Mentor</span></div></div><nav class="menu"><p class="menu-title">HƯỚNG DẪN THỰC TẬP</p><a class="menu-item" href="${pageContext.request.contextPath}/mentor/dashboard"><i class="fa-solid fa-chart-pie"></i><span>Tổng quan</span></a><a class="menu-item" href="${pageContext.request.contextPath}/mentor/reports"><i class="fa-solid fa-file-circle-check"></i><span>Báo cáo tuần</span></a><a class="menu-item active" href="${pageContext.request.contextPath}/mentor/evaluations"><i class="fa-solid fa-list-check"></i><span>Đánh giá tổng kết</span></a><a class="menu-item" href="${pageContext.request.contextPath}/meetings"><i class="fa-solid fa-video"></i><span>Lịch họp</span></a></nav></aside>
<main class="main"><header class="header intern-header"><div class="mentor-context header-context"><i class="fa-solid fa-award"></i><span>Tổng kết năng lực thực tập</span></div><%@ include file="includes/hr-header-actions.jspf" %></header><section class="content mentor-content evaluation-content"><div class="evaluation-heading"><div><p class="eyebrow">ĐÁNH GIÁ CUỐI KỲ</p><h1>Đánh giá thực tập sinh</h1><p>Ghi nhận năng lực, thái độ và đề xuất của mentor. Kết quả sẽ chờ HR xác nhận.</p></div><a href="${pageContext.request.contextPath}/mentor/dashboard"><i class="fa-solid fa-arrow-left"></i> Tổng quan</a></div>
<c:if test="${param.success=='saved'}"><div class="mentor-alert success"><i class="fa-solid fa-circle-check"></i> Đã lưu đánh giá tổng kết và chuyển kết quả sang HR xác nhận.</div></c:if><c:if test="${not empty param.error}"><div class="mentor-alert error"><i class="fa-solid fa-triangle-exclamation"></i> <c:out value="${param.error}"/></div></c:if>
<div class="evaluation-layout"><aside class="evaluation-roster"><div class="evaluation-roster-heading"><div><h2>Thực tập sinh</h2><p>${evaluations.size()} thành viên được phân công</p></div><i class="fa-solid fa-users"></i></div><c:forEach items="${evaluations}" var="intern"><a class="evaluation-person ${selectedInternId==intern.intern_id?'selected':''}" href="?internId=${intern.intern_id}"><span class="evaluation-avatar"><i class="fa-solid fa-user-graduate"></i></span><span class="evaluation-person-info"><strong><c:out value="${intern.full_name}"/></strong><small><c:out value="${intern.intern_code}"/> · <c:out value="${intern.program_name}" default="Chưa có chương trình"/></small><em class="evaluation-state ${empty intern.final_score?'draft':'submitted'}">${empty intern.final_score?'Chưa đánh giá':intern.hr_approval_status=='PENDING'?'Chờ HR xác nhận':'Đã xác nhận'}</em></span><i class="fa-solid fa-chevron-right"></i></a></c:forEach><c:if test="${empty evaluations}"><div class="empty-box"><i class="fa-solid fa-users-slash"></i><strong>Chưa có thành viên</strong><p>HR chưa phân công thực tập sinh cho bạn.</p></div></c:if></aside>
<section class="evaluation-main"><c:choose><c:when test="${empty selectedEvaluation}"><div class="empty-box large"><i class="fa-solid fa-clipboard-check"></i><strong>Chọn thực tập sinh để đánh giá</strong><p>Danh sách chỉ gồm thành viên bạn đang hướng dẫn.</p></div></c:when><c:otherwise><div class="evaluation-person-header"><div><span class="evaluation-avatar large"><i class="fa-solid fa-user-graduate"></i></span><div><h2><c:out value="${selectedEvaluation.full_name}"/></h2><p><c:out value="${selectedEvaluation.intern_code}"/> · <c:out value="${selectedEvaluation.program_name}" default="Chưa có chương trình"/></p></div></div><span class="review-status"><i class="fa-solid fa-hourglass-half"></i> Chờ HR xác nhận</span></div>
<form class="evaluation-form" method="post" action="${pageContext.request.contextPath}/mentor/evaluations"><input type="hidden" name="internId" value="${selectedEvaluation.intern_id}"><div class="evaluation-form-title"><div><h3>Phiếu đánh giá cuối kỳ</h3><p>Nhập điểm từ 0 đến 10 cho từng tiêu chí.</p></div><span class="evaluation-scale">THANG ĐIỂM <strong>0–10</strong></span></div>
<div class="score-grid"><label class="score-field"><span class="score-label"><i class="fa-solid fa-laptop-code"></i><span><strong>Kỹ năng chuyên môn</strong><small>Năng lực áp dụng kiến thức, chất lượng công việc · trọng số 50%</small></span></span><span class="score-input"><input required type="number" name="skillScore" min="0" max="10" step="0.1" value="${selectedEvaluation.skill_score}" placeholder="0.0"><b>/ 10</b></span></label><label class="score-field"><span class="score-label"><i class="fa-solid fa-heart"></i><span><strong>Thái độ và tinh thần học hỏi</strong><small>Chủ động, hợp tác, tiếp nhận phản hồi · trọng số 30%</small></span></span><span class="score-input"><input required type="number" name="attitudeScore" min="0" max="10" step="0.1" value="${selectedEvaluation.attitude_score}" placeholder="0.0"><b>/ 10</b></span></label><label class="score-field"><span class="score-label"><i class="fa-solid fa-clock"></i><span><strong>Tác phong và kỷ luật</strong><small>Đúng giờ, trách nhiệm, tuân thủ quy trình · trọng số 20%</small></span></span><span class="score-input"><input required type="number" name="punctualityScore" min="0" max="10" step="0.1" value="${selectedEvaluation.punctuality_score}" placeholder="0.0"><b>/ 10</b></span></label></div>
<div class="evaluation-summary"><span><i class="fa-solid fa-calculator"></i> Điểm tổng kết có trọng số</span><strong id="finalScore"><c:out value="${selectedEvaluation.final_score}" default="—"/><small>/ 10</small></strong><em id="finalGrade"><c:choose><c:when test="${selectedEvaluation.final_grade=='EXCELLENT'}">Xuất sắc</c:when><c:when test="${selectedEvaluation.final_grade=='GOOD'}">Tốt</c:when><c:when test="${selectedEvaluation.final_grade=='PASS'}">Đạt</c:when><c:when test="${selectedEvaluation.final_grade=='FAIL'}">Chưa đạt</c:when><c:otherwise>Nhập đủ điểm để tính</c:otherwise></c:choose></em></div>
<label class="evaluation-comments"><span>Nhận xét tổng kết <small>Bắt buộc, tối thiểu 10 ký tự</small></span><textarea name="comments" required minlength="10" maxlength="3000" placeholder="Nêu điểm mạnh, nội dung cần cải thiện và hướng phát triển tiếp theo..."><c:out value="${selectedEvaluation.overall_comments}"/></textarea></label><label class="hire-recommendation"><input type="checkbox" name="recommendHiring" value="true" ${selectedEvaluation.recommend_hiring?'checked':''}><span><strong>Đề xuất tuyển dụng</strong><small>Mentor khuyến nghị xem xét thực tập sinh cho vị trí phù hợp.</small></span></label>
<div class="evaluation-submit-row"><p><i class="fa-solid fa-circle-info"></i> Lưu đánh giá sẽ gửi thông báo cho thực tập sinh và chuyển hồ sơ sang HR.</p><button type="submit"><i class="fa-solid fa-paper-plane"></i> Lưu và gửi HR xác nhận</button></div></form></c:otherwise></c:choose></section></div></section></main></div><script src="${pageContext.request.contextPath}/frontend/js/intern-header.js?v=20261010-2"></script><script>
const scoreInputs = [...document.querySelectorAll('.score-field input')];
const finalScore = document.querySelector('#finalScore');
const finalGrade = document.querySelector('#finalGrade');
function updateEvaluationScore() {
  if (!scoreInputs.length || !finalScore || scoreInputs.some(input => input.value === '')) return;
  const score = Math.round((Number(scoreInputs[0].value) * .5 + Number(scoreInputs[1].value) * .3 + Number(scoreInputs[2].value) * .2) * 100) / 100;
  finalScore.firstChild.textContent = score.toFixed(2);
  finalGrade.textContent = score >= 9 ? 'Xuất sắc' : score >= 8 ? 'Tốt' : score >= 5 ? 'Đạt' : 'Chưa đạt';
}
scoreInputs.forEach(input => input.addEventListener('input', updateEvaluationScore));
updateEvaluationScore();
</script></body></html>