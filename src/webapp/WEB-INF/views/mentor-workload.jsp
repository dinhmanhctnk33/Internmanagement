<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Tải công việc mentor - IMS Portal</title><link rel="stylesheet" href="${pageContext.request.contextPath}/frontend/css/dashboard.css?v=20261015-2"><link rel="stylesheet" href="${pageContext.request.contextPath}/frontend/css/intern-work.css?v=20261015-2"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head><body><div class="layout"><%@ include file="includes/final-report-sidebar.jspf" %><main class="main"><header class="header"><div><strong><i class="fa-solid fa-scale-balanced"></i>&nbsp; Theo dõi mentor</strong></div><%@ include file="includes/hr-header-actions.jspf" %></header><section class="content work-page"><div class="page-title"><div><h1>Khối lượng hướng dẫn</h1><p>Theo dõi số thực tập sinh đang hoạt động của từng mentor để phân công cân bằng.</p></div></div>
<div class="summary-grid"><div class="summary"><div class="summary-icon"><i class="fa-solid fa-chalkboard-user"></i></div><div><strong>${mentorCount}</strong><span>Mentor đang hoạt động</span></div></div><div class="summary"><div class="summary-icon"><i class="fa-solid fa-user-graduate"></i></div><div><strong>${internCount}</strong><span>Thực tập sinh đang được hướng dẫn</span></div></div><div class="summary"><div class="summary-icon"><i class="fa-solid fa-triangle-exclamation"></i></div><div><strong class="${overloadedCount > 0 ? 'load-high' : 'load-ok'}">${overloadedCount}</strong><span>Mentor vượt ngưỡng ${capacity} thực tập sinh</span></div></div></div>
<section class="work-card"><div class="work-card-head"><div><h2>Phân bổ theo mentor</h2><p>Ngưỡng khuyến nghị: tối đa ${capacity} thực tập sinh / mentor.</p></div><form method="get" class="compact-search"><input name="q" value="<c:out value='${keyword}'/>" placeholder="Tìm theo tên hoặc email mentor"><button class="btn-primary" aria-label="Tìm kiếm"><i class="fa-solid fa-magnifying-glass"></i></button></form></div><div class="work-body" style="padding:0"><div class="history-wrap"><table class="history"><thead><tr><th>Mentor</th><th>Phòng ban</th><th>Số TTS</th><th>Mức tải</th><th>Khuyến nghị</th></tr></thead><tbody><c:forEach var="m" items="${mentors}"><tr><td><strong><c:out value="${m.full_name}"/></strong><div class="muted"><c:out value="${m.email}"/></div></td><td><c:out value="${m.dept_name}" default="Chưa xếp phòng"/></td><td><span class="workload-number">${m.intern_count}</span></td><td class="recommendation"><c:choose><c:when test="${m.intern_count > capacity}"><span class="status load-high">Quá tải</span></c:when><c:when test="${m.intern_count == capacity}"><span class="status load-warn">Gần đầy</span></c:when><c:otherwise><span class="status load-ok">Còn khả dụng</span></c:otherwise></c:choose></td><td class="recommendation"><c:choose><c:when test="${m.intern_count > capacity}">Cân nhắc chuyển bớt ${m.intern_count-capacity} TTS</c:when><c:otherwise>Có thể nhận thêm ${capacity-m.intern_count} TTS</c:otherwise></c:choose></td></tr></c:forEach><c:if test="${empty mentors}"><tr><td colspan="5" class="empty-state">Không tìm thấy mentor phù hợp.</td></tr></c:if></tbody></table></div></div></section></section></main></div></body></html>
