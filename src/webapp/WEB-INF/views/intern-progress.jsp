<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Cập nhật tiến độ - IMS Portal</title><link rel="stylesheet" href="${pageContext.request.contextPath}/frontend/css/dashboard.css?v=20261015-2"><link rel="stylesheet" href="${pageContext.request.contextPath}/frontend/css/intern-work.css?v=20261015-2"><link rel="stylesheet" href="${pageContext.request.contextPath}/frontend/css/intern-progress.css?v=20261016-2"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head><body><div class="layout">
<aside class="sidebar"><div class="logo"><div class="logo-icon"><i class="fa-solid fa-user-graduate"></i></div><div><h2>IMS Portal</h2><span>Không gian Thực tập sinh</span></div></div><nav class="menu"></nav></aside>
<main class="main"><header class="header"><div><strong><i class="fa-solid fa-bars-progress"></i>&nbsp; Cập nhật tiến độ</strong></div><%@ include file="includes/hr-header-actions.jspf" %></header><section class="content work-page"><div class="page-title"><div><h1>Tiến độ công việc</h1><p>Cập nhật mức hoàn thành và ghi chú để mentor theo dõi.</p></div></div>
<c:if test="${param.success == 'updated'}"><div class="notice success"><i class="fa-solid fa-circle-check"></i> Đã cập nhật tiến độ và thông báo cho mentor.</div></c:if><c:if test="${not empty param.error}"><div class="notice error"><c:out value="${param.error}"/></div></c:if>
<div class="work-card"><div class="work-card-head"><div><h2>Nhiệm vụ được giao</h2><p>Các thay đổi được ghi nhận ngay sau khi lưu.</p></div><span class="section-count"><i class="fa-solid fa-list-check"></i> ${tasks.size()} nhiệm vụ</span></div><div class="work-body"><c:choose><c:when test="${empty tasks}"><div class="empty-state"><i class="fa-regular fa-folder-open fa-2x"></i><p>Chưa có nhiệm vụ nào được giao.</p></div></c:when><c:otherwise><div class="task-list"><c:forEach var="t" items="${tasks}"><article class="task"><div class="task-top"><div class="task-title-wrap"><h3 class="task-title"><c:out value="${t.task_title}"/></h3><p class="muted task-description"><c:out value="${t.description}"/></p><button class="task-detail-trigger" type="button"><i class="fa-regular fa-eye"></i> Xem chi tiết</button><div class="task-meta"><span><i class="fa-solid fa-user-tie"></i><c:out value="${t.mentor_name}" default="Mentor"/></span><span><i class="fa-regular fa-calendar"></i>Hạn: ${t.due_date}</span></div></div><span class="status"><c:out value="${t.priority}"/></span></div><div class="progress-line"><div class="progress-track"><span style="width:${t.completion_percent}%"></span></div><span class="progress-value">${t.completion_percent}%</span></div><form class="edit-row" method="post"><input type="hidden" name="taskId" value="${t.id}"><div class="field"><label>Hoàn thành (%)</label><input type="number" name="percent" min="0" max="100" value="${t.completion_percent}" required></div><div class="field"><label>Trạng thái</label><select name="status"><option value="TODO" ${t.status=='TODO'?'selected':''}>Chưa bắt đầu</option><option value="IN_PROGRESS" ${t.status=='IN_PROGRESS'?'selected':''}>Đang thực hiện</option><option value="COMPLETED" ${t.status=='COMPLETED'?'selected':''}>Hoàn thành</option></select></div><div class="field"><label>Ghi chú cho mentor</label><input name="note" maxlength="500" value="<c:out value='${t.intern_note}'/>" placeholder="Kết quả, vướng mắc hoặc bước tiếp theo"></div><button class="btn-primary"><i class="fa-solid fa-floppy-disk"></i> Lưu</button></form></article></c:forEach></div></c:otherwise></c:choose></div></div></section></main></div>
<dialog class="task-detail-dialog" id="taskDetailDialog" aria-labelledby="taskDetailTitle"><div class="task-detail-head"><div><span>Chi tiết nhiệm vụ</span><h2 id="taskDetailTitle"></h2></div><button type="button" class="task-detail-close" aria-label="Đóng"><i class="fa-solid fa-xmark"></i></button></div><div class="task-detail-body"><h3>Mô tả công việc</h3><p id="taskDetailDescription"></p></div><div class="task-detail-actions"><button type="button" class="btn-primary task-detail-done">Đã hiểu</button></div></dialog>
<script src="${pageContext.request.contextPath}/frontend/js/intern-progress.js?v=20261016-1"></script></body></html>
