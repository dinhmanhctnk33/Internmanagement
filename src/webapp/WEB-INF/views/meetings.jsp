<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<fmt:formatDate value="${editingMeeting.start_time}" pattern="HH:mm" var="editStart"/>
<fmt:formatDate value="${editingMeeting.end_time}" pattern="HH:mm" var="editEnd"/>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Lịch họp & Email tự động</title><link rel="stylesheet" href="${pageContext.request.contextPath}/frontend/css/dashboard.css?v=20261012-3"><link rel="stylesheet" href="${pageContext.request.contextPath}/frontend/css/intern-header.css?v=20261012-2"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/frontend/css/meeting-management.css?v=20261012-2"></head>
<body><div class="layout"><aside class="sidebar"><div class="logo"><div class="logo-icon"><i class="fa-solid fa-user-tie"></i></div><div><h2>IMS Portal</h2><span>${sessionScope.userRole=='MENTOR'?'Dành cho Mentor':'Phòng Nhân sự (HR)'}</span></div></div><nav class="menu"><p class="menu-title">${sessionScope.userRole=='MENTOR'?'NGHIỆP VỤ MENTOR':'NGHIỆP VỤ HR'}</p><a href="${pageContext.request.contextPath}/home" class="menu-item"><i class="fa-solid fa-chart-line"></i><span>Dashboard</span></a><c:if test="${sessionScope.userRole=='HR' || sessionScope.userRole=='ADMIN'}"><a href="${pageContext.request.contextPath}/interns" class="menu-item"><i class="fa-solid fa-users"></i><span>Thực tập sinh &amp; Lọc</span></a><a href="${pageContext.request.contextPath}/documents/review" class="menu-item"><i class="fa-solid fa-file-circle-check"></i><span>Duyệt tài liệu &amp; CV</span></a><a href="${pageContext.request.contextPath}/review-emails" class="menu-item"><i class="fa-solid fa-envelope-circle-check"></i><span>Email kết quả</span></a><p class="menu-title">QUY TRÌNH THỰC TẬP</p><a href="${pageContext.request.contextPath}/programs" class="menu-item"><i class="fa-solid fa-calendar-days"></i><span>Chương trình thực tập</span></a><a href="${pageContext.request.contextPath}/contracts" class="menu-item"><i class="fa-solid fa-file-contract"></i><span>Hợp đồng thực tập</span></a><a href="${pageContext.request.contextPath}/mentor-assignments" class="menu-item"><i class="fa-solid fa-user-group"></i><span>Phân công mentor</span></a></c:if><a href="${pageContext.request.contextPath}/meetings" class="menu-item active"><i class="fa-solid fa-video"></i><span>Lịch họp</span></a><c:if test="${sessionScope.userRole=='HR' || sessionScope.userRole=='ADMIN'}"><a href="${pageContext.request.contextPath}/attendance-report" class="menu-item"><i class="fa-solid fa-chart-column"></i><span>Báo cáo chuyên cần</span></a></c:if></nav></aside>
<main class="main"><header class="header intern-header"><div class="meeting-context"><i class="fa-solid fa-calendar-check"></i><span>Điều phối lịch họp</span></div><%@ include file="includes/hr-header-actions.jspf" %></header>
<section class="meeting-page"><div class="meeting-heading"><div><p class="eyebrow">Lịch &amp; thông báo</p><h1>Quản lý lịch họp</h1><p>Tạo lịch cho thực tập sinh và theo dõi email mời, cập nhật hoặc hủy theo từng người nhận.</p></div><button type="button" class="primary-action" data-open-form><i class="fa-solid fa-plus"></i> Tạo lịch họp</button></div>
<c:if test="${not empty param.error}"><div class="alert error"><i class="fa-solid fa-circle-exclamation"></i><c:out value="${param.error}"/></div></c:if><c:if test="${not empty param.success}"><div class="alert success"><i class="fa-solid fa-circle-check"></i>${param.success=='created'?'Đã tạo lịch và xếp hàng email mời.':param.success=='updated'?'Đã cập nhật lịch và tạo email cho các thay đổi quan trọng.':'Đã hủy lịch và xếp hàng email thông báo hủy.'}</div></c:if>
<div class="meeting-layout"><section class="meeting-card list-card"><div class="card-toolbar"><div><h2>Danh sách lịch họp</h2><p>${meetings.size()} lịch trong phạm vi của bạn</p></div><form method="get"><select name="status" onchange="this.form.submit()"><option value="ALL">Tất cả trạng thái</option><option value="ACTIVE" ${selectedStatus=='ACTIVE'?'selected':''}>Đang hiệu lực</option><option value="CANCELLED" ${selectedStatus=='CANCELLED'?'selected':''}>Đã hủy</option></select></form></div>
<div class="meeting-list"><c:forEach items="${meetings}" var="m"><article class="meeting-row ${m.status=='CANCELLED'?'cancelled':''}"><div class="date-box"><strong>${m.meeting_date}</strong><span><fmt:formatDate value="${m.start_time}" pattern="HH:mm"/>–<fmt:formatDate value="${m.end_time}" pattern="HH:mm"/></span></div><div class="meeting-info"><div><h3><c:out value="${m.title}"/></h3><span class="status ${m.status}">${m.status=='ACTIVE'?'Đang hiệu lực':'Đã hủy'}</span></div><p><i class="fa-solid ${m.meeting_mode=='ONLINE'?'fa-link':'fa-location-dot'}"></i> <c:out value="${m.location_or_link}"/></p><small>Tạo bởi <c:out value="${m.creator_name}"/> · ${m.recipient_count} người nhận</small></div><div class="delivery"><span><i class="fa-solid fa-paper-plane"></i> ${m.sent_count}/${m.recipient_count} đã gửi</span><c:if test="${m.failed_count>0}"><b>${m.failed_count} gửi lỗi</b></c:if><a href="?status=${selectedStatus}&edit=${m.id}"><i class="fa-solid fa-pen"></i> Chi tiết</a></div></article></c:forEach><c:if test="${empty meetings}"><div class="empty"><i class="fa-regular fa-calendar-xmark"></i><h3>Chưa có lịch họp</h3><p>Tạo lịch đầu tiên để hệ thống thông báo cho thực tập sinh.</p></div></c:if></div></section>
<aside class="meeting-card process-card"><div class="card-toolbar"><div><h2>Luồng gửi tự động</h2><p>Email được xử lý trong vài phút</p></div></div><ol class="process"><li><span>1</span><div><b>Kiểm tra &amp; lưu lịch</b><p>Kiểm tra thời gian, hình thức và phạm vi người nhận.</p></div></li><li><span>2</span><div><b>Chốt danh sách nhận</b><p>Mỗi thực tập sinh có một bản ghi, không gửi trùng.</p></div></li><li><span>3</span><div><b>Xếp hàng gửi ngay</b><p>Tạo email mời, cập nhật hoặc hủy theo thay đổi.</p></div></li><li><span>4</span><div><b>Ghi nhận kết quả</b><p>Hiển thị đã gửi hoặc gửi lỗi cho từng người.</p></div></li></ol><div class="rule-note"><i class="fa-solid fa-circle-info"></i><p>Sửa riêng phần mô tả không phát sinh email cập nhật. Cuộc họp đã kết thúc chỉ được xem.</p></div></aside></div>
</section></main></div>
<div class="modal ${not empty editingMeeting?'open':''}" id="meetingModal" aria-hidden="${empty editingMeeting}"><div class="modal-backdrop" data-close-form></div><section class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="meetingFormTitle"><div class="modal-header"><div><p class="eyebrow">${empty editingMeeting?'Tạo mới':'Chi tiết & cập nhật'}</p><h2 id="meetingFormTitle">${empty editingMeeting?'Tạo lịch họp':'Cập nhật lịch họp'}</h2></div><button type="button" data-close-form aria-label="Đóng"><i class="fa-solid fa-xmark"></i></button></div>
<form method="post" id="meetingForm"><input type="hidden" name="action" value="${empty editingMeeting?'create':'update'}"><c:if test="${not empty editingMeeting}"><input type="hidden" name="meetingId" value="${editingMeeting.id}"><input type="hidden" name="version" value="${editingMeeting.version_no}"></c:if><div class="form-grid"><label class="full"><span>Tiêu đề *</span><input name="title" maxlength="200" required value="<c:out value='${editingMeeting.title}'/>" placeholder="Ví dụ: Họp rà soát tiến độ tuần 3"></label><label><span>Ngày họp *</span><input type="date" name="meetingDate" required value="${editingMeeting.meeting_date}"></label><div class="time-pair"><label><span>Bắt đầu *</span><input type="time" name="startTime" required value="${editStart}"></label><label><span>Kết thúc *</span><input type="time" name="endTime" required value="${editEnd}"></label></div><label><span>Hình thức *</span><select name="meetingMode" id="meetingMode"><option value="ONLINE" ${editingMeeting.meeting_mode=='ONLINE'?'selected':''}>Trực tuyến</option><option value="OFFLINE" ${editingMeeting.meeting_mode=='OFFLINE'?'selected':''}>Trực tiếp</option></select></label><label><span id="placeLabel">Liên kết họp *</span><input name="locationOrLink" required value="<c:out value='${editingMeeting.location_or_link}'/>" placeholder="https://meet..."></label><label class="full"><span>Mô tả</span><textarea name="description" rows="3" placeholder="Nội dung chuẩn bị, ghi chú..."><c:out value="${editingMeeting.description}"/></textarea><small>Chỉ sửa mô tả sẽ không gửi email cập nhật.</small></label></div>
<div class="recipient-section"><div class="recipient-head"><div><b>Người nhận *</b><small>Mentor chỉ thấy thực tập sinh mình đang hướng dẫn.</small></div><div class="recipient-tools"><input id="recipientSearch" placeholder="Tìm tên, mã hoặc chương trình"><button type="button" id="selectAll">Chọn tất cả đang hiển thị</button></div></div><div class="recipient-list"><c:forEach items="${interns}" var="i"><label data-recipient="${i.full_name} ${i.intern_code} ${i.program_name}"><input type="checkbox" name="recipientIds" value="${i.id}" <c:forEach items="${editingRecipients}" var="er">${er.intern_profile_id==i.id && er.is_active?'checked':''}</c:forEach>><span class="recipient-avatar"><i class="fa-solid fa-user-graduate"></i></span><span><b><c:out value="${i.full_name}"/></b><small><c:out value="${i.intern_code}"/> · <c:out value="${i.program_name}" default="Chưa có chương trình"/></small></span></label></c:forEach></div><p class="recipient-count"><strong id="selectedCount">0</strong> thực tập sinh đã chọn</p></div>
<c:if test="${not empty editingRecipients}"><div class="delivery-detail"><h3>Trạng thái email theo người nhận</h3><c:forEach items="${editingRecipients}" var="r"><div><span><c:out value="${r.recipient_name}"/> <small><c:out value="${r.recipient_email}"/></small></span><b class="mail-status ${r.last_email_status}">${r.last_email_status=='SENT'?'Đã gửi':r.last_email_status=='PENDING'?'Đang chờ':'Gửi lỗi'}</b></div></c:forEach></div></c:if>
<div class="form-actions"><c:if test="${not empty editingMeeting && editingMeeting.status=='ACTIVE'}"><button class="danger" type="submit" name="action" value="cancel" formnovalidate data-confirm-cancel><i class="fa-solid fa-ban"></i> Hủy lịch họp</button></c:if><span></span><button type="button" class="secondary" data-close-form>Đóng</button><button type="submit" class="primary"><i class="fa-solid fa-paper-plane"></i> ${empty editingMeeting?'Tạo và gửi thông báo':'Lưu thay đổi'}</button></div></form></section></div>
<script src="${pageContext.request.contextPath}/frontend/js/meeting-management.js"></script><script src="${pageContext.request.contextPath}/frontend/js/intern-header.js"></script></body></html>
