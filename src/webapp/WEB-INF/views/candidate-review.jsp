<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Xác nhận kết quả ứng viên - IMS</title><link rel="stylesheet" href="${pageContext.request.contextPath}/frontend/css/dashboard.css?v=20261007-4"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
<style>.review-tools{display:flex;gap:12px;align-items:end;margin-bottom:20px}.review-tools label{display:grid;gap:6px;color:var(--text-muted);font-size:13px}.review-tools input,.review-tools select,.decision-form textarea{border:1px solid var(--border-color);border-radius:8px;padding:10px 12px;font:inherit}.review-tools .search{flex:1}.decision-form{min-width:310px}.decision-form textarea{width:100%;min-height:62px;resize:vertical;margin-bottom:8px}.decision-actions{display:flex;gap:8px}.pass-btn,.fail-btn{border:0;border-radius:7px;padding:9px 13px;color:#fff;font-weight:700;cursor:pointer}.pass-btn{background:#18794e}.fail-btn{background:#b42318}.result-alert{padding:13px 16px;margin-bottom:18px;border-radius:9px;background:#edf9f2;border:1px solid #b7e4c7;color:#18794e}.result-alert.error{background:#fff1f1;border-color:#efc1c1;color:#a61b1b}.candidate-meta small{display:block;color:var(--text-muted);margin-top:4px}.status-final{opacity:.72}.status-final strong{display:block;margin-bottom:5px}</style></head>
<body><div class="layout"><aside class="sidebar"><div class="logo"><div class="logo-icon"><i class="fa-solid fa-user-tie"></i></div><div><h2>IMS Portal</h2><span>Phòng Nhân sự (HR)</span></div></div><nav class="menu"><p class="menu-title">NGHIỆP VỤ HR</p><a href="${pageContext.request.contextPath}/home" class="menu-item"><i class="fa-solid fa-chart-line"></i><span>Dashboard HR</span></a><a href="${pageContext.request.contextPath}/applications" class="menu-item active"><i class="fa-solid fa-user-check"></i><span>Kết quả ứng viên</span></a><a href="${pageContext.request.contextPath}/review-emails" class="menu-item"><i class="fa-solid fa-envelope-circle-check"></i><span>Email kết quả</span></a></nav><div class="sidebar-bottom"><a href="${pageContext.request.contextPath}/logout" class="menu-item logout"><i class="fa-solid fa-right-from-bracket"></i><span>Đăng xuất</span></a></div></aside>
<main class="main"><header class="header"></header><section class="content"><div class="page-title"><div><h1><i class="fa-solid fa-user-check" style="color:var(--action-accent);margin-right:10px"></i>Xác nhận kết quả ứng viên</h1><p>HR chỉ cần chọn Đỗ hoặc Trượt và nhập lý do; hệ thống tự gửi email theo mẫu có sẵn.</p></div></div>
<c:if test="${param.result=='sent'}"><div class="result-alert">Đã lưu kết quả và gửi email cho ứng viên.</div></c:if><c:if test="${param.result=='queued'}"><div class="result-alert">Đã lưu kết quả. Email đang chờ hệ thống gửi lại.</div></c:if><c:if test="${not empty param.error}"><div class="result-alert error"><c:out value="${param.error}"/></div></c:if>
<form class="review-tools" method="get"><label>Trạng thái<select name="status"><option value="">Tất cả</option><option value="NEW" ${selectedStatus=='NEW'?'selected':''}>Chờ xét</option><option value="INTERVIEWING" ${selectedStatus=='INTERVIEWING'?'selected':''}>Đang phỏng vấn</option><option value="ACCEPTED" ${selectedStatus=='ACCEPTED'?'selected':''}>Đỗ</option><option value="REJECTED" ${selectedStatus=='REJECTED'?'selected':''}>Trượt</option></select></label><label class="search">Tìm ứng viên<input name="q" value="<c:out value='${keyword}'/>" placeholder="Tên hoặc email"></label><button class="primary-btn">Lọc</button></form>
<div class="card"><div class="table-container"><table><thead><tr><th>Ứng viên</th><th>Học vấn</th><th>Vị trí mong muốn</th><th>Trạng thái</th><th>Xác nhận kết quả</th></tr></thead><tbody><c:forEach items="${candidates}" var="a"><tr><td class="candidate-meta"><strong><c:out value="${a.full_name}"/></strong><small><c:out value="${a.email}"/></small><small><c:out value="${a.phone}"/></small></td><td><c:out value="${a.university_name}"/><small style="display:block;color:var(--text-muted)"><c:out value="${a.major_name}"/></small></td><td><c:out value="${a.desired_position}"/></td><td><span class="badge ${a.application_status=='ACCEPTED'?'active':(a.application_status=='REJECTED'?'inactive':'pending')}">${a.application_status=='ACCEPTED'?'Đỗ':(a.application_status=='REJECTED'?'Trượt':(a.application_status=='INTERVIEWING'?'Đang phỏng vấn':'Chờ xét'))}</span></td><td><c:choose><c:when test="${a.application_status=='NEW'||a.application_status=='INTERVIEWING'}"><form method="post" class="decision-form"><input type="hidden" name="candidateId" value="${a.id}"><textarea name="reason" required minlength="5" placeholder="Nhập lý do xác nhận kết quả..."></textarea><div class="decision-actions"><button class="pass-btn" name="decision" value="PASSED">Xác nhận Đỗ</button><button class="fail-btn" name="decision" value="FAILED">Xác nhận Trượt</button></div></form></c:when><c:otherwise><div class="status-final"><strong>Đã xác nhận</strong><c:out value="${a.hr_notes}"/></div></c:otherwise></c:choose></td></tr></c:forEach><c:if test="${empty candidates}"><tr><td colspan="5" style="padding:42px;text-align:center;color:var(--text-muted)">Không có ứng viên phù hợp.</td></tr></c:if></tbody></table></div></div></section></main></div></body></html>
