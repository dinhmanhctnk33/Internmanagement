<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Báo cáo tuần - IMS Portal</title><link rel="stylesheet" href="${pageContext.request.contextPath}/frontend/css/dashboard.css?v=20261015-2"><link rel="stylesheet" href="${pageContext.request.contextPath}/frontend/css/intern-work.css?v=20261015-3"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head><body><div class="layout">
<aside class="sidebar"><div class="logo"><div class="logo-icon"><i class="fa-solid fa-user-graduate"></i></div><div><h2>IMS Portal</h2><span>Không gian Thực tập sinh</span></div></div><nav class="menu"></nav></aside>
<main class="main"><header class="header"><div><strong><i class="fa-solid fa-file-circle-check"></i>&nbsp; Báo cáo tuần</strong></div><%@ include file="includes/hr-header-actions.jspf" %></header><section class="content work-page report-page"><div class="page-title"><div><h1>Nộp báo cáo tuần</h1><p>Tổng hợp kết quả, kiến thức và vướng mắc trong tuần.</p></div></div>
<c:if test="${param.success == 'submitted'}"><div class="notice success"><i class="fa-solid fa-circle-check"></i> Báo cáo đã được nộp và mentor đã nhận thông báo.</div></c:if><c:if test="${not empty param.error}"><div class="notice error"><c:out value="${param.error}"/></div></c:if>
<div class="work-grid"><section class="work-card"><div class="work-card-head"><div><h2>Thông tin báo cáo</h2><p>Nộp lại cùng số tuần sẽ cập nhật báo cáo chưa được duyệt.</p></div></div><div class="work-body"><div class="helper-note"><i class="fa-solid fa-circle-info"></i><span>Điền thông tin ngắn gọn, tập trung vào kết quả và vấn đề cần mentor hỗ trợ.</span></div><form method="post" class="report-form"><div class="field week-field"><label>Tuần số *</label><input type="number" name="week" min="1" max="53" required></div><div class="field date-field"><label>Từ ngày *</label><input type="date" name="startDate" required></div><div class="field date-field"><label>Đến ngày *</label><input type="date" name="endDate" required></div><div class="field wide"><label>Công việc đã hoàn thành *</label><textarea name="completedWork" maxlength="4000" minlength="10" required></textarea></div><div class="field half"><label>Kiến thức / kỹ năng học được</label><textarea name="keyLearnings" maxlength="4000"></textarea></div><div class="field half"><label>Khó khăn, vướng mắc</label><textarea name="obstacles" maxlength="4000"></textarea></div><div class="field wide"><label>Liên kết tệp minh chứng</label><input type="url" name="attachmentUrl" maxlength="500" placeholder="https://..."></div><div class="wide form-actions"><button class="btn-primary"><i class="fa-solid fa-paper-plane"></i> Nộp báo cáo</button></div></form></div></section>
<section class="work-card"><div class="work-card-head"><div><h2>Lịch sử báo cáo</h2><p>Theo dõi trạng thái và phản hồi của mentor.</p></div></div><div class="work-body"><c:choose><c:when test="${empty reports}"><div class="empty-state">Chưa có báo cáo nào.</div></c:when><c:otherwise><div class="history-wrap"><table class="history"><thead><tr><th>Tuần</th><th>Thời gian</th><th>Trạng thái</th><th>Điểm</th><th>Phản hồi</th></tr></thead><tbody><c:forEach var="r" items="${reports}"><tr><td><strong>Tuần ${r.week_number}</strong></td><td>${r.start_date} – ${r.end_date}</td><td><span class="status">${r.status}</span></td><td>${empty r.mentor_score ? '—' : r.mentor_score}</td><td><c:out value="${r.mentor_feedback}" default="—"/></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></div></section></div></section></main></div></body></html>
