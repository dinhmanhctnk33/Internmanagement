<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Chấm công - IMS</title><link rel="stylesheet" href="${pageContext.request.contextPath}/frontend/css/dashboard.css?v=20261008-1"><link rel="stylesheet" href="${pageContext.request.contextPath}/frontend/css/intern-operations.css?v=20261010-1"><link rel="stylesheet" href="${pageContext.request.contextPath}/frontend/css/intern-header.css?v=20261008-1"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head>
<body><div class="layout"><aside class="sidebar"><div class="logo"><div class="logo-icon"><i class="fa-solid fa-user-graduate"></i></div><div><h2>IMS Portal</h2><span>Dành cho Thực tập sinh</span></div></div><nav class="menu"><p class="menu-title">TRANG CÁ NHÂN</p><a href="${pageContext.request.contextPath}/home" class="menu-item"><i class="fa-solid fa-house"></i><span>Trang cá nhân</span></a><a href="${pageContext.request.contextPath}/interns/profile" class="menu-item"><i class="fa-solid fa-id-card"></i><span>Hồ sơ của tôi</span></a><a href="${pageContext.request.contextPath}/my-contract" class="menu-item"><i class="fa-solid fa-file-contract"></i><span>Hợp đồng của tôi</span></a><a href="${pageContext.request.contextPath}/my-calendar" class="menu-item"><i class="fa-solid fa-calendar-days"></i><span>Lịch thực tập</span></a><a href="${pageContext.request.contextPath}/attendance" class="menu-item active"><i class="fa-solid fa-clock"></i><span>Check-in / Check-out</span></a></nav></aside>
<main class="main"><header class="header intern-header"><div class="header-context"><i class="fa-regular fa-clock"></i><span>Ghi nhận thời gian làm việc</span></div><div class="header-right"><div class="notification-wrap"><button class="notification" id="notificationButton" type="button" aria-label="Thông báo" aria-expanded="false"><i class="fa-regular fa-bell"></i></button><div class="notification-menu" id="notificationMenu" hidden><h3><i class="fa-solid fa-bell"></i> Thông báo</h3><div class="notification-empty">Xem các thông báo mới nhất của bạn.</div><a class="notification-item notification-all" href="${pageContext.request.contextPath}/notifications">Xem tất cả thông báo <i class="fa-solid fa-arrow-right"></i></a></div></div><div class="account-menu"><button class="account-trigger user" id="accountMenuButton" type="button" aria-expanded="false"><div class="avatar">${currentUser.shortName}</div><div class="user-info"><strong><c:out value="${currentUser.fullName}"/></strong><small>Thực tập sinh (INTERN)</small></div><i class="fa-solid fa-chevron-down account-chevron"></i></button><div class="account-dropdown" id="accountMenu" hidden><a href="${pageContext.request.contextPath}/change-password"><i class="fa-solid fa-key"></i> Đổi mật khẩu</a><a class="logout-link" href="${pageContext.request.contextPath}/logout"><i class="fa-solid fa-right-from-bracket"></i> Đăng xuất</a></div></div></div></header>
<section class="content operation-page"><div class="operation-heading"><div><p class="eyebrow">Chuyên cần cá nhân</p><h1>Check-in / Check-out</h1><p>Thời điểm chấm công được lấy trực tiếp từ máy chủ của hệ thống.</p></div><div class="live-time"><i class="fa-regular fa-calendar"></i><span id="serverClock">--:--:--</span></div></div>
<c:if test="${param.success=='checked-in'}"><div class="feedback success"><i class="fa-solid fa-circle-check"></i> Check-in thành công.</div></c:if><c:if test="${param.success=='checked-out'}"><div class="feedback success"><i class="fa-solid fa-circle-check"></i> Check-out thành công.</div></c:if><c:if test="${not empty param.error}"><div class="feedback error"><i class="fa-solid fa-triangle-exclamation"></i> <c:out value="${param.error}"/></div></c:if><c:if test="${not empty errorMessage}"><div class="feedback error"><c:out value="${errorMessage}"/></div></c:if>
<div class="attendance-layout"><section class="check-card"><div class="status-orb ${empty today?'idle':empty today.check_out_display?'working':'done'}"><i class="fa-solid ${empty today?'fa-fingerprint':empty today.check_out_display?'fa-person-walking':'fa-check'}"></i></div><c:choose><c:when test="${empty today}"><span class="state-label idle">Chưa check-in</span><h2>Bắt đầu ngày làm việc</h2><p>Nhấn nút bên dưới khi bạn đã có mặt và sẵn sàng làm việc.</p><form method="post" class="once-form"><input type="hidden" name="action" value="check-in"><button type="submit" class="check-button"><i class="fa-solid fa-right-to-bracket"></i> Check-in ngay</button></form></c:when><c:when test="${empty today.check_out_display}"><span class="state-label working">Đang làm việc</span><h2>Đã vào lúc ${today.check_in_display}</h2><p>Hãy check-out khi bạn kết thúc ngày làm việc.</p><form method="post" class="once-form"><input type="hidden" name="action" value="check-out"><button type="submit" class="check-button checkout"><i class="fa-solid fa-right-from-bracket"></i> Check-out ngay</button></form></c:when><c:otherwise><span class="state-label done">Đã hoàn tất</span><h2>${today.check_in_display} — ${today.check_out_display}</h2><p>Thời gian làm việc hôm nay đã được ghi nhận.</p><button class="check-button disabled" disabled><i class="fa-solid fa-check"></i> Hoàn tất hôm nay</button></c:otherwise></c:choose></section>
<aside class="month-card"><div class="month-icon"><i class="fa-solid fa-chart-pie"></i></div><small>THÁNG HIỆN TẠI</small><strong>${monthSummary.work_days}<span> ngày làm việc</span></strong><p><c:set var="hours" value="${monthSummary.total_minutes div 60}"/>${hours.intValue()} giờ ${monthSummary.total_minutes mod 60} phút đã ghi nhận</p></aside></div>
<section class="history-card"><div class="card-heading"><div><h2>Lịch sử chấm công</h2><p>31 bản ghi gần nhất của bạn.</p></div><span>${records.size()} ngày</span></div><div class="table-wrap"><table><thead><tr><th>NGÀY</th><th>GIỜ VÀO</th><th>GIỜ RA</th><th>THỜI LƯỢNG</th><th>TRẠNG THÁI</th></tr></thead><tbody><c:forEach items="${records}" var="r"><tr><td><strong>${r.work_date}</strong></td><td>${empty r.check_in_display?'—':r.check_in_display}</td><td>${empty r.check_out_display?'—':r.check_out_display}</td><td><c:choose><c:when test="${empty r.total_minutes}">Đang cập nhật</c:when><c:otherwise>${(r.total_minutes div 60).intValue()} giờ ${r.total_minutes mod 60} phút</c:otherwise></c:choose></td><td><span class="record-status ${empty r.check_out_display?'progress':'complete'}"><i class="fa-solid ${empty r.check_out_display?'fa-spinner':'fa-circle-check'}"></i> ${empty r.check_out_display?'Đang làm việc':'Hoàn tất'}</span></td></tr></c:forEach><c:if test="${empty records}"><tr><td colspan="5" class="empty-row"><i class="fa-regular fa-clock"></i><br>Chưa có dữ liệu chấm công.</td></tr></c:if></tbody></table></div></section>
<section class="history-card leave-card"><div class="card-heading"><div><h2>Đơn nghỉ phép</h2><p>Gửi đơn và theo dõi kết quả xét duyệt.</p></div><span>${leaveRequests.size()} đơn</span></div><form action="${pageContext.request.contextPath}/leave-requests" method="post" class="leave-request-form"><label><span>Loại nghỉ</span><select name="leaveType" required><option value="SICK_LEAVE">Nghỉ ốm</option><option value="PERSONAL_LEAVE">Nghỉ cá nhân</option><option value="UNPAID_LEAVE">Nghỉ không lương</option></select></label><label><span>Từ ngày</span><input type="date" name="startDate" required></label><label><span>Đến ngày</span><input type="date" name="endDate" required></label><label class="leave-reason"><span>Lý do</span><input name="reason" minlength="5" placeholder="Nhập lý do nghỉ" required></label><button class="check-button leave-submit" type="submit"><i class="fa-regular fa-paper-plane"></i> Gửi đơn</button></form><div class="table-wrap"><table><thead><tr><th>THỜI GIAN</th><th>LOẠI</th><th>LÝ DO</th><th>TRẠNG THÁI</th></tr></thead><tbody><c:forEach items="${leaveRequests}" var="l"><tr><td>${l.start_date} — ${l.end_date}</td><td>${l.leave_type=='SICK_LEAVE'?'Nghỉ ốm':l.leave_type=='PERSONAL_LEAVE'?'Nghỉ cá nhân':'Nghỉ không lương'}</td><td><c:out value="${l.reason}"/></td><td><span class="leave-status ${l.approval_status}">${l.approval_status=='APPROVED'?'Đã duyệt':l.approval_status=='REJECTED'?'Từ chối':'Chờ duyệt'}</span></td></tr></c:forEach><c:if test="${empty leaveRequests}"><tr><td colspan="4" class="empty-row">Chưa có đơn nghỉ phép.</td></tr></c:if></tbody></table></div></section></section></main></div>
<script>function tick(){document.getElementById('serverClock').textContent=new Date().toLocaleTimeString('vi-VN')}tick();setInterval(tick,1000);document.querySelectorAll('.once-form').forEach(function(f){f.addEventListener('submit',function(){f.querySelector('button').disabled=true})});</script><script src="${pageContext.request.contextPath}/frontend/js/intern-header.js?v=20261008-1"></script></body></html>
