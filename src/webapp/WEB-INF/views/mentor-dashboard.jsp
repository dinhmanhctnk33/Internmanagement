<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Tổng quan Mentor - IMS</title><link rel="stylesheet" href="${pageContext.request.contextPath}/frontend/css/dashboard.css?v=20261012-3"><link rel="stylesheet" href="${pageContext.request.contextPath}/frontend/css/intern-header.css?v=20261010-2"><link rel="stylesheet" href="${pageContext.request.contextPath}/frontend/css/mentor-workspace.css?v=20261012-2"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head>
<body><div class="layout"><aside class="sidebar mentor-sidebar"><div class="logo"><div class="logo-icon"><i class="fa-solid fa-chalkboard-user"></i></div><div><h2>IMS Portal</h2><span>Không gian Mentor</span></div></div><nav class="menu"><p class="menu-title">HƯỚNG DẪN THỰC TẬP</p><a class="menu-item active" href="${pageContext.request.contextPath}/mentor/dashboard"><i class="fa-solid fa-chart-pie"></i><span>Tổng quan</span></a><a class="menu-item" href="${pageContext.request.contextPath}/mentor/reports"><i class="fa-solid fa-file-circle-check"></i><span>Báo cáo tuần</span></a><a class="menu-item" href="${pageContext.request.contextPath}/mentor/final-evaluation"><i class="fa-solid fa-star-half-stroke"></i><span>Đánh giá tổng kết</span></a><a class="menu-item" href="${pageContext.request.contextPath}/meetings"><i class="fa-solid fa-video"></i><span>Lịch họp</span></a></nav></aside>
<main class="main"><header class="header intern-header"><div class="mentor-context header-context"><i class="fa-solid fa-compass"></i><span>Trung tâm hướng dẫn</span></div><%@ include file="includes/hr-header-actions.jspf" %></header><section class="content mentor-content"><div class="mentor-welcome"><div><p class="eyebrow">TỔNG QUAN CÔNG VIỆC</p><h1>Xin chào, <c:out value="${currentUser.fullName}"/></h1><p>Theo dõi nhóm thực tập sinh và ưu tiên những báo cáo đang chờ bạn hỗ trợ.</p></div><a class="primary-link" href="${pageContext.request.contextPath}/mentor/reports?status=SUBMITTED"><i class="fa-solid fa-inbox"></i> Xử lý báo cáo chờ</a></div>
<div class="mentor-metrics"><article><span class="metric-symbol blue"><i class="fa-solid fa-user-graduate"></i></span><div><small>THỰC TẬP SINH</small><strong>${summary.intern_count}</strong><p>Đang được hướng dẫn</p></div></article><article><span class="metric-symbol amber"><i class="fa-solid fa-clock"></i></span><div><small>CHỜ PHẢN HỒI</small><strong>${summary.pending_count}</strong><p>Cần mentor xem xét</p></div></article><article><span class="metric-symbol green"><i class="fa-solid fa-circle-check"></i></span><div><small>ĐÃ DUYỆT</small><strong>${summary.approved_count}</strong><p>Báo cáo hoàn tất</p></div></article><article><span class="metric-symbol purple"><i class="fa-solid fa-star"></i></span><div><small>ĐIỂM TRUNG BÌNH</small><strong>${empty summary.average_score?'—':summary.average_score}</strong><p>Trên thang điểm 10</p></div></article></div>
<div class="mentor-dashboard-grid"><section class="workspace-card"><div class="card-title"><div><h2>Nhóm thực tập sinh</h2><p>Tình trạng báo cáo của từng thành viên.</p></div><span>${interns.size()} thành viên</span></div><div class="intern-overview-list"><c:forEach items="${interns}" var="intern"><article><span class="person-icon"><i class="fa-solid fa-user-graduate"></i></span><div class="person-main"><strong><c:out value="${intern.full_name}"/></strong><small><c:out value="${intern.intern_code}"/> · <c:out value="${intern.program_name}" default="Chưa có chương trình"/></small></div><div class="report-progress"><b>${intern.report_count} báo cáo</b><small>${intern.pending_count>0?intern.pending_count:'Không'} chờ phản hồi</small></div><a href="${pageContext.request.contextPath}/mentor/reports?internId=${intern.id}">Xem <i class="fa-solid fa-arrow-right"></i></a></article></c:forEach><c:if test="${empty interns}"><div class="empty-box"><i class="fa-solid fa-users-slash"></i><strong>Chưa có thực tập sinh</strong><p>HR chưa phân công thành viên nào cho bạn.</p></div></c:if></div></section>
<section class="workspace-card recent-card"><div class="card-title"><div><h2>Báo cáo gần đây</h2><p>Cập nhật mới nhất từ nhóm.</p></div></div><div class="recent-report-list"><c:forEach items="${recentReports}" var="report"><a href="${pageContext.request.contextPath}/mentor/reports?reportId=${report.id}"><span class="report-week">T${report.week_number}</span><div><strong><c:out value="${report.full_name}"/></strong><small>${report.start_date} – ${report.end_date}</small></div><b class="report-status ${report.status}">${report.status=='SUBMITTED'?'Chờ xem':report.status=='APPROVED'?'Đã duyệt':'Cần sửa'}</b></a></c:forEach><c:if test="${empty recentReports}"><div class="empty-box compact">Chưa có báo cáo tuần.</div></c:if></div><a class="card-footer-link" href="${pageContext.request.contextPath}/mentor/reports">Xem toàn bộ báo cáo <i class="fa-solid fa-arrow-right"></i></a></section></div></section></main></div><script src="${pageContext.request.contextPath}/frontend/js/intern-header.js?v=20261010-2"></script></body></html>
