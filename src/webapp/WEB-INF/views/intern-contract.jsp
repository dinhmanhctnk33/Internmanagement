<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Hợp đồng của tôi - IMS</title><link rel="stylesheet" href="${pageContext.request.contextPath}/frontend/css/dashboard.css?v=20261008-1"><link rel="stylesheet" href="${pageContext.request.contextPath}/frontend/css/intern-operations.css?v=20261008-1"><link rel="stylesheet" href="${pageContext.request.contextPath}/frontend/css/intern-header.css?v=20261008-1"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head>
<body><div class="layout"><aside class="sidebar"><div class="logo"><div class="logo-icon"><i class="fa-solid fa-user-graduate"></i></div><div><h2>IMS Portal</h2><span>Dành cho Thực tập sinh</span></div></div><nav class="menu"><p class="menu-title">TRANG CÁ NHÂN</p><a href="${pageContext.request.contextPath}/home" class="menu-item"><i class="fa-solid fa-house"></i><span>Trang cá nhân</span></a><a href="${pageContext.request.contextPath}/interns/profile" class="menu-item"><i class="fa-solid fa-id-card"></i><span>Hồ sơ của tôi</span></a><a href="${pageContext.request.contextPath}/my-contract" class="menu-item active"><i class="fa-solid fa-file-contract"></i><span>Hợp đồng của tôi</span></a><a href="${pageContext.request.contextPath}/my-calendar" class="menu-item"><i class="fa-solid fa-calendar-days"></i><span>Lịch thực tập</span></a><a href="${pageContext.request.contextPath}/attendance" class="menu-item"><i class="fa-solid fa-clock"></i><span>Check-in / Check-out</span></a></nav></aside>
<main class="main"><header class="header intern-header"><div class="header-context"><i class="fa-regular fa-file-lines"></i><span>Thủ tục tiếp nhận</span></div><div class="header-right"><div class="notification-wrap"><button class="notification" id="notificationButton" type="button" aria-label="Thông báo" aria-expanded="false"><i class="fa-regular fa-bell"></i></button><div class="notification-menu" id="notificationMenu" hidden><h3><i class="fa-solid fa-bell"></i> Thông báo</h3><div class="notification-empty">Xem các thông báo mới nhất của bạn.</div><a class="notification-item notification-all" href="${pageContext.request.contextPath}/notifications">Xem tất cả thông báo <i class="fa-solid fa-arrow-right"></i></a></div></div><div class="account-menu"><button class="account-trigger user" id="accountMenuButton" type="button" aria-expanded="false"><div class="avatar">${currentUser.shortName}</div><div class="user-info"><strong><c:out value="${currentUser.fullName}"/></strong><small>Thực tập sinh (INTERN)</small></div><i class="fa-solid fa-chevron-down account-chevron"></i></button><div class="account-dropdown" id="accountMenu" hidden><a href="${pageContext.request.contextPath}/change-password"><i class="fa-solid fa-key"></i> Đổi mật khẩu</a><a class="logout-link" href="${pageContext.request.contextPath}/logout"><i class="fa-solid fa-right-from-bracket"></i> Đăng xuất</a></div></div></div></header><section class="content operation-page"><div class="operation-heading"><div><p class="eyebrow">Thủ tục tiếp nhận</p><h1>Hợp đồng thực tập</h1><p>Đọc kỹ bản PDF hiện hành trước khi xác nhận hoàn tất thủ tục.</p></div></div>
<c:if test="${param.success=='confirmed'}"><div class="feedback success"><i class="fa-solid fa-circle-check"></i> Hợp đồng đã được xác nhận thành công.</div></c:if><c:if test="${not empty param.error}"><div class="feedback error"><i class="fa-solid fa-triangle-exclamation"></i> <c:out value="${param.error}"/></div></c:if>
<c:choose><c:when test="${empty contract}"><div class="contract-empty"><i class="fa-regular fa-folder-open"></i><h2>Chưa có hợp đồng</h2><p>HR chưa gửi hợp đồng cho bạn. Thông tin sẽ xuất hiện tại đây khi hợp đồng sẵn sàng.</p></div></c:when><c:otherwise><div class="contract-layout"><section class="contract-document"><div class="document-icon"><i class="fa-regular fa-file-pdf"></i></div><div><span class="contract-status ${contract.signature_status=='SIGNED'?'signed':'pending'}"><i class="fa-solid ${contract.signature_status=='SIGNED'?'fa-circle-check':'fa-clock'}"></i> ${contract.signature_status=='SIGNED'?'Đã xác nhận':'Chờ xác nhận'}</span><h2><c:out value="${contract.contract_number}"/></h2><p><c:out value="${contract.program_name}"/> · <c:out value="${contract.dept_name}"/></p></div><a target="_blank" rel="noopener" id="openContractPdf" class="view-contract" href="${pageContext.request.contextPath}/my-contract?open=${contract.id}"><i class="fa-solid fa-arrow-up-right-from-square"></i> Mở bản PDF</a></section><section class="contract-details"><div><small>Ngày bắt đầu</small><strong>${contract.effective_date}</strong></div><i class="fa-solid fa-arrow-right"></i><div><small>Ngày kết thúc</small><strong>${contract.expiration_date}</strong></div><div><small>Trạng thái</small><strong>${contract.signature_status=='SIGNED'?'Đã hoàn tất thủ tục':'Đang chờ bạn xác nhận'}</strong></div></section>
<c:choose><c:when test="${contract.signature_status=='SIGNED'}"><div class="confirmed-panel"><i class="fa-solid fa-shield-circle-check"></i><div><h3>Hợp đồng đã được xác nhận</h3><p>Thời điểm xác nhận: ${contract.signed_at}</p></div></div></c:when><c:otherwise><form method="post" class="confirm-panel"><input type="hidden" name="contractId" value="${contract.id}"><div class="confirm-title"><span>1</span><div><h3>Mở và kiểm tra hợp đồng</h3><p>Nút xác nhận chỉ khả dụng sau khi bạn đã mở bản PDF.</p></div><b id="contractViewedStatus" class="${contractViewed?'complete':''}"><i class="fa-solid ${contractViewed?'fa-check':'fa-hourglass-half'}"></i> <span>${contractViewed?'Đã mở':'Chưa mở'}</span></b></div><label class="agreement"><input id="contractAgreement" type="checkbox" name="agreement" required ${contractViewed?'':'disabled'}><span>Tôi xác nhận đã đọc, hiểu và đồng ý với toàn bộ nội dung của hợp đồng thực tập hiện hành.</span></label><button id="confirmContractButton" type="submit" class="confirm-button" disabled><i class="fa-solid fa-file-signature"></i> Xác nhận hợp đồng</button></form></c:otherwise></c:choose></div></c:otherwise></c:choose></section></main></div><script src="${pageContext.request.contextPath}/frontend/js/intern-header.js?v=20261008-1"></script><script src="${pageContext.request.contextPath}/frontend/js/intern-contract.js?v=20261008-1"></script></body></html>
