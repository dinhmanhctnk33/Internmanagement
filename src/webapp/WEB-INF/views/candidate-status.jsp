<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Hồ sơ ứng tuyển - IMS</title><link rel="stylesheet" href="${pageContext.request.contextPath}/frontend/css/business.css?v=20261008-1"></head><body class="auth-page"><main class="auth-shell"><section class="auth-intro"><div class="auth-logo">IMS Portal</div><h1>Hồ sơ ứng tuyển của tôi</h1><p>Kết quả xét duyệt sẽ được cập nhật tại đây và gửi đến email đăng ký.</p><a href="${pageContext.request.contextPath}/logout" style="color:#fff">Đăng xuất</a></section><section class="auth-card"><c:choose><c:when test="${empty application}"><div class="alert error">Không tìm thấy hồ sơ ứng tuyển.</div></c:when><c:otherwise><div class="auth-heading"><p>TRẠNG THÁI HIỆN TẠI</p><h2>${application.application_status=='ACCEPTED'?'Đỗ':(application.application_status=='REJECTED'?'Trượt':'Đang chờ xét duyệt')}</h2></div><div class="auth-form"><p><strong>Ứng viên:</strong> <c:out value="${application.full_name}"/></p><p><strong>Vị trí:</strong> <c:out value="${application.desired_position}"/></p><p><strong>Trường/Chuyên ngành:</strong> <c:out value="${application.university_name}"/> · <c:out value="${application.major_name}"/></p><p><strong>Ngày nộp:</strong> ${application.applied_at}</p><c:if test="${not empty application.hr_notes}"><div class="alert"><strong>Nhận xét từ HR:</strong><br><c:out value="${application.hr_notes}"/></div></c:if><a href="${pageContext.request.contextPath}${application.cv_file_url}" target="_blank">Xem CV đã nộp</a></div></c:otherwise></c:choose></section></main></body></html>
