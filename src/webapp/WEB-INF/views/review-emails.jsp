<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Email kết quả ứng viên - IMS</title><link rel="stylesheet" href="${pageContext.request.contextPath}/frontend/css/dashboard.css?v=20261007-4"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"><style>.mail-status{display:inline-flex;padding:5px 9px;border-radius:999px;font-size:11px;font-weight:800}.mail-status.SENT{background:#def7ec;color:#18794e}.mail-status.PENDING,.mail-status.PROCESSING{background:#fff4d6;color:#996515}.mail-status.FAILED,.mail-status.FAILED_FINAL{background:#fde8e8;color:#b42318}.mail-note{max-width:290px;white-space:normal;color:var(--text-muted);font-size:12px}.config-alert{padding:13px 16px;margin-bottom:18px;border-radius:9px;background:#fff8e6;border:1px solid #f1d694;color:#805b10}</style></head>
<body><div class="layout"><aside class="sidebar"><div class="logo"><div class="logo-icon"><i class="fa-solid fa-user-tie"></i></div><div><h2>IMS Portal</h2><span>Phòng Nhân sự (HR)</span></div></div><nav class="menu"><p class="menu-title">NGHIỆP VỤ HR</p><a href="${pageContext.request.contextPath}/home" class="menu-item"><i class="fa-solid fa-chart-line"></i><span>Dashboard HR</span></a><a href="${pageContext.request.contextPath}/applications" class="menu-item"><i class="fa-solid fa-user-check"></i><span>Kết quả ứng viên</span></a><a href="${pageContext.request.contextPath}/review-emails" class="menu-item active"><i class="fa-solid fa-envelope-circle-check"></i><span>Email kết quả</span></a></nav><div class="sidebar-bottom"><a href="${pageContext.request.contextPath}/logout" class="menu-item logout"><i class="fa-solid fa-right-from-bracket"></i><span>Đăng xuất</span></a></div></aside>
<main class="main"><header class="header"></header><section class="content"><div class="page-title"><div><h1><i class="fa-solid fa-envelope-circle-check" style="color:var(--action-accent);margin-right:10px"></i>Email thông báo kết quả</h1><p>Theo dõi email Đỗ/Trượt được hệ thống tự động gửi sau khi HR xác nhận kết quả.</p></div></div>
<c:if test="${not smtpConfigured}"><div class="config-alert"><i class="fa-solid fa-triangle-exclamation"></i> SMTP chưa được cấu hình. Email vẫn được giữ trong hàng đợi để gửi lại sau.</div></c:if>
<div class="card"><div class="table-container"><table><thead><tr><th>Ứng viên</th><th>Vị trí ứng tuyển</th><th>Kết quả</th><th>Lý do</th><th>Trạng thái email</th><th>Lần thử</th><th>Thông tin lỗi</th></tr></thead><tbody><c:forEach items="${jobs}" var="job"><tr><td><strong><c:out value="${job.recipientName}"/></strong><small style="display:block;color:var(--text-muted)"><c:out value="${job.recipientEmail}"/></small></td><td><c:out value="${job.desiredPosition}"/></td><td><span class="badge ${job.decision=='PASSED'?'active':'inactive'}">${job.decision=='PASSED'?'Đỗ':'Trượt'}</span></td><td><c:out value="${job.decisionReason}"/></td><td><span class="mail-status ${job.status}">${job.status}</span></td><td>${job.attemptCount}</td><td class="mail-note"><c:out value="${empty job.lastError?'-':job.lastError}"/></td></tr></c:forEach><c:if test="${empty jobs}"><tr><td colspan="7" style="padding:42px;text-align:center;color:var(--text-muted)">Chưa có email kết quả ứng viên nào.</td></tr></c:if></tbody></table></div></div></section></main></div></body></html>
