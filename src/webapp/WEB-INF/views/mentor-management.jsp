<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Quản lý mentor - IMS</title>
<link rel="stylesheet" href="${pageContext.request.contextPath}/frontend/css/dashboard.css?v=20261014"><link rel="stylesheet" href="${pageContext.request.contextPath}/frontend/css/intern-header.css?v=20261014"><link rel="stylesheet" href="${pageContext.request.contextPath}/frontend/css/mentor-management.css?v=20261014-1"><link rel="stylesheet" href="${pageContext.request.contextPath}/frontend/css/mentor-management-v2.css?v=20261014-2"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head>
<body><c:set var="activeMenu" value="mentors"/><div class="layout"><%@ include file="includes/final-report-sidebar.jspf" %><main class="main"><header class="header intern-header"><div class="mentor-context"><i class="fa-solid fa-chalkboard-user"></i><span>Quản lý mentor</span></div><%@ include file="includes/hr-header-actions.jspf" %></header>
<section class="content mentor-page"><div class="mentor-heading"><div><span>ĐỘI NGŨ HƯỚNG DẪN</span><h1>Quản lý mentor</h1><p>Quản lý hồ sơ và tình trạng sẵn sàng của đội ngũ hướng dẫn thực tập.</p></div><a class="add-mentor-shortcut" href="#createMentor"><i class="fa-solid fa-plus"></i>Thêm mentor</a></div>
<c:set var="activeCount" value="0"/><c:set var="linkedCount" value="0"/><c:set var="unlinkedCount" value="0"/><c:forEach var="m" items="${mentors}"><c:if test="${m.status == 'ACTIVE'}"><c:set var="activeCount" value="${activeCount + 1}"/></c:if><c:choose><c:when test="${empty m.user_id}"><c:set var="unlinkedCount" value="${unlinkedCount + 1}"/></c:when><c:otherwise><c:set var="linkedCount" value="${linkedCount + 1}"/></c:otherwise></c:choose></c:forEach>
<div class="mentor-metrics"><article><span class="metric-icon total"><i class="fa-solid fa-users"></i></span><div><small>TỔNG HỒ SƠ</small><strong>${fn:length(mentors)}</strong><p>Theo bộ lọc hiện tại</p></div></article><article><span class="metric-icon active"><i class="fa-solid fa-user-check"></i></span><div><small>ĐANG HOẠT ĐỘNG</small><strong>${activeCount}</strong><p>Sẵn sàng phân công</p></div></article><article><span class="metric-icon linked"><i class="fa-solid fa-link"></i></span><div><small>ĐÃ LIÊN KẾT</small><strong>${linkedCount}</strong><p>Có thể đăng nhập hệ thống</p></div></article><article class="${unlinkedCount > 0 ? 'needs-attention' : ''}"><span class="metric-icon unlinked"><i class="fa-solid fa-link-slash"></i></span><div><small>CHƯA LIÊN KẾT</small><strong>${unlinkedCount}</strong><p>Cần cấp tài khoản mentor</p></div></article></div>
<c:if test="${param.success == 'created'}"><div class="mentor-alert success"><i class="fa-solid fa-circle-check"></i>Đã thêm hồ sơ mentor.</div></c:if><c:if test="${not empty param.error}"><div class="mentor-alert error"><i class="fa-solid fa-circle-exclamation"></i><c:out value="${param.error}"/></div></c:if>
<section class="mentor-card create-card" id="createMentor"><div class="card-title"><div class="title-icon"><i class="fa-solid fa-user-plus"></i></div><div><h2>Thêm mentor mới</h2><p>Nhập thông tin cơ bản. Hệ thống tự liên kết tài khoản mentor có cùng email.</p></div><span class="required-note"><b>*</b> Bắt buộc</span></div><form method="post" action="${pageContext.request.contextPath}/mentors" class="mentor-create-form"><label><span>Họ và tên <b>*</b></span><input name="fullName" maxlength="150" autocomplete="name" required placeholder="Ví dụ: Nguyễn Văn An"></label><label><span>Email công việc <b>*</b></span><input name="email" type="email" maxlength="254" autocomplete="email" required placeholder="mentor@company.com"></label><label><span>Phòng ban <b>*</b></span><select name="departmentId" required><option value="">Chọn phòng ban</option><c:forEach var="d" items="${departments}"><option value="${d.id}"><c:out value="${d.dept_name}"/></option></c:forEach></select></label><div class="create-action"><button type="submit"><i class="fa-solid fa-user-plus"></i>Tạo hồ sơ mentor</button><small>Không tự tạo mật khẩu đăng nhập.</small></div></form></section>
<form class="mentor-filter" method="get"><label><span>Tìm kiếm</span><div><i class="fa-solid fa-magnifying-glass"></i><input name="q" value="<c:out value='${q}'/>" placeholder="Tên hoặc email"></div></label><label><span>Phòng ban</span><select name="departmentId"><option value="">Tất cả phòng ban</option><c:forEach var="d" items="${departments}"><option value="${d.id}" ${selectedDepartment==d.id?'selected':''}><c:out value="${d.dept_name}"/></option></c:forEach></select></label><label><span>Trạng thái</span><select name="status"><option value="ALL">Tất cả trạng thái</option><option value="ACTIVE" ${selectedStatus=='ACTIVE'?'selected':''}>Đang hoạt động</option><option value="INACTIVE" ${selectedStatus=='INACTIVE'?'selected':''}>Ngừng hoạt động</option></select></label><button><i class="fa-solid fa-filter"></i>Lọc</button><a href="${pageContext.request.contextPath}/mentors" title="Đặt lại"><i class="fa-solid fa-rotate-left"></i></a></form>
<section class="mentor-card list-card"><div class="list-title"><div><h2>Danh sách mentor</h2><p>Theo dõi trạng thái tài khoản và số thực tập sinh đang hướng dẫn.</p></div><span>${fn:length(mentors)} hồ sơ</span></div><div class="mentor-table-wrap"><table><thead><tr><th>Mentor</th><th>Phòng ban</th><th>Liên kết tài khoản</th><th>Đang hướng dẫn</th><th>Trạng thái</th></tr></thead><tbody><c:forEach var="m" items="${mentors}"><tr><td><div class="mentor-person"><span>${fn:substring(m.full_name,0,1)}</span><div><strong><c:out value="${m.full_name}"/></strong><small><c:out value="${m.email}"/> · <c:out value="${m.mentor_code}"/></small></div></div></td><td><c:out value="${m.dept_name}" default="Chưa xác định"/></td><td><span class="link-badge ${empty m.user_id?'unlinked':'linked'}"><i class="fa-solid ${empty m.user_id?'fa-link-slash':'fa-link'}"></i>${empty m.user_id?'Chưa liên kết':'Đã liên kết'}</span></td><td><span class="load-count">${m.intern_count}</span> thực tập sinh</td><td><span class="status-badge ${m.status=='ACTIVE'?'active':'inactive'}">${m.status=='ACTIVE'?'Đang hoạt động':'Ngừng hoạt động'}</span></td></tr></c:forEach><c:if test="${empty mentors}"><tr><td colspan="5" class="empty-mentors"><i class="fa-regular fa-folder-open"></i><strong>Không tìm thấy mentor</strong><span>Thử thay đổi bộ lọc hoặc thêm hồ sơ mới.</span></td></tr></c:if></tbody></table></div></section>
</section></main></div><script src="${pageContext.request.contextPath}/frontend/js/intern-header.js?v=20261013-2"></script></body></html>
