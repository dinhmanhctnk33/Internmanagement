<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Báo cáo tuần - Mentor</title><link rel="stylesheet" href="${pageContext.request.contextPath}/frontend/css/dashboard.css?v=20261012-3"><link rel="stylesheet" href="${pageContext.request.contextPath}/frontend/css/intern-header.css?v=20261010-2"><link rel="stylesheet" href="${pageContext.request.contextPath}/frontend/css/mentor-workspace.css?v=20261012-2"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head>
<body><div class="layout"><aside class="sidebar mentor-sidebar"><div class="logo"><div class="logo-icon"><i class="fa-solid fa-chalkboard-user"></i></div><div><h2>IMS Portal</h2><span>Không gian Mentor</span></div></div><nav class="menu"><p class="menu-title">HƯỚNG DẪN THỰC TẬP</p><a class="menu-item" href="${pageContext.request.contextPath}/mentor/dashboard"><i class="fa-solid fa-chart-pie"></i><span>Tổng quan</span></a><a class="menu-item active" href="${pageContext.request.contextPath}/mentor/reports"><i class="fa-solid fa-file-circle-check"></i><span>Báo cáo tuần</span></a><a class="menu-item" href="${pageContext.request.contextPath}/mentor/evaluations"><i class="fa-solid fa-list-check"></i><span>Đánh giá tổng kết</span></a><a class="menu-item" href="${pageContext.request.contextPath}/meetings"><i class="fa-solid fa-video"></i><span>Lịch họp</span></a></nav></aside>
<main class="main"><header class="header intern-header"><div class="mentor-context header-context"><i class="fa-solid fa-file-signature"></i><span>Đánh giá báo cáo tuần</span></div><%@ include file="includes/hr-header-actions.jspf" %></header><section class="content mentor-content"><div class="report-page-heading"><div><p class="eyebrow">THEO DÕI TIẾN ĐỘ</p><h1>Báo cáo tuần</h1><p>Đọc kết quả, ghi nhận điểm và phản hồi cụ thể để hỗ trợ thực tập sinh.</p></div><a href="${pageContext.request.contextPath}/mentor/dashboard"><i class="fa-solid fa-arrow-left"></i> Về tổng quan</a></div>
<c:if test="${param.success=='reviewed'}"><div class="mentor-alert success"><i class="fa-solid fa-circle-check"></i> Đã lưu phản hồi và thông báo cho thực tập sinh.</div></c:if><c:if test="${not empty param.error}"><div class="mentor-alert error"><i class="fa-solid fa-triangle-exclamation"></i> <c:out value="${param.error}"/></div></c:if>
<form class="report-filters" method="get"><label>Thực tập sinh<select name="internId"><option value="">Tất cả thành viên</option><c:forEach items="${interns}" var="intern"><option value="${intern.id}" ${selectedInternId==intern.id?'selected':''}><c:out value="${intern.full_name}"/> · <c:out value="${intern.intern_code}"/></option></c:forEach></select></label><label>Trạng thái<select name="status"><option value="ALL">Tất cả trạng thái</option><option value="SUBMITTED" ${selectedStatus=='SUBMITTED'?'selected':''}>Chờ phản hồi</option><option value="APPROVED" ${selectedStatus=='APPROVED'?'selected':''}>Đã duyệt</option><option value="REJECTED" ${selectedStatus=='REJECTED'?'selected':''}>Yêu cầu chỉnh sửa</option></select></label><button><i class="fa-solid fa-filter"></i> Áp dụng</button><a href="${pageContext.request.contextPath}/mentor/reports" title="Xóa bộ lọc"><i class="fa-solid fa-rotate-left"></i></a></form>
<div class="report-workspace"><section class="report-inbox"><div class="card-title"><div><h2>Hộp báo cáo</h2><p>Ưu tiên báo cáo đang chờ phản hồi.</p></div><span>${reports.size()} báo cáo</span></div><div class="report-inbox-list"><c:forEach items="${reports}" var="report"><a class="report-inbox-item ${selectedReport.id==report.id?'selected':''}" href="?reportId=${report.id}&amp;status=${selectedStatus}${not empty selectedInternId?'&amp;internId=':''}${selectedInternId}"><span class="report-week">T${report.week_number}</span><div><strong><c:out value="${report.full_name}"/></strong><small>${report.start_date} – ${report.end_date}</small><em class="report-status ${report.status}">${report.status=='SUBMITTED'?'Chờ phản hồi':report.status=='APPROVED'?'Đã duyệt':'Cần chỉnh sửa'}</em></div><i class="fa-solid fa-chevron-right"></i></a></c:forEach><c:if test="${empty reports}"><div class="empty-box"><i class="fa-regular fa-folder-open"></i><strong>Không có báo cáo</strong><p>Chưa có dữ liệu phù hợp bộ lọc.</p></div></c:if></div></section>
<section class="report-detail"><c:choose><c:when test="${empty selectedReport}"><div class="empty-box large"><i class="fa-solid fa-file-circle-question"></i><strong>Chọn một báo cáo</strong><p>Chi tiết và biểu mẫu phản hồi sẽ hiển thị tại đây.</p></div></c:when><c:otherwise><div class="detail-header"><div><span class="report-week large">Tuần ${selectedReport.week_number}</span><div><h2><c:out value="${selectedReport.full_name}"/></h2><p><c:out value="${selectedReport.intern_code}"/> · <c:out value="${selectedReport.program_name}" default="Chưa có chương trình"/></p></div></div><em class="report-status ${selectedReport.status}">${selectedReport.status=='SUBMITTED'?'Chờ phản hồi':selectedReport.status=='APPROVED'?'Đã duyệt':'Cần chỉnh sửa'}</em></div><div class="report-period"><i class="fa-regular fa-calendar"></i><span>Kỳ báo cáo</span><strong>${selectedReport.start_date} – ${selectedReport.end_date}</strong></div>
<div class="report-sections"><article><span><i class="fa-solid fa-list-check"></i></span><div><h3>Công việc đã hoàn thành</h3><p><c:out value="${selectedReport.completed_work}" default="Chưa có nội dung"/></p></div></article><article><span><i class="fa-solid fa-lightbulb"></i></span><div><h3>Kiến thức và kinh nghiệm</h3><p><c:out value="${selectedReport.key_learnings}" default="Chưa có nội dung"/></p></div></article><article class="obstacle"><span><i class="fa-solid fa-triangle-exclamation"></i></span><div><h3>Khó khăn cần hỗ trợ</h3><p><c:out value="${selectedReport.obstacles}" default="Không có khó khăn được ghi nhận"/></p></div></article></div>
<c:if test="${not empty selectedReport.attachment_url}"><a class="attachment-link" href="${selectedReport.attachment_url}" target="_blank" rel="noopener"><i class="fa-solid fa-paperclip"></i> Xem tài liệu đính kèm</a></c:if>
<form class="feedback-form" method="post"><input type="hidden" name="reportId" value="${selectedReport.id}"><div class="feedback-heading"><div><h3>Phản hồi của mentor</h3><p>Nêu điểm tốt, vấn đề cần cải thiện và hướng xử lý tiếp theo.</p></div><label>Điểm tuần<input name="score" type="number" min="0" max="10" step="0.1" value="${selectedReport.mentor_score}" placeholder="0–10"></label></div><textarea name="feedback" minlength="5" required placeholder="Ví dụ: Em đã hoàn thành tốt phần API. Tuần tới cần bổ sung kiểm thử và cập nhật tài liệu..."><c:out value="${selectedReport.mentor_feedback}"/></textarea><div class="feedback-actions"><button name="action" value="reject" class="request-change"><i class="fa-solid fa-rotate-left"></i> Yêu cầu chỉnh sửa</button><button name="action" value="approve" class="approve"><i class="fa-solid fa-check"></i> Duyệt báo cáo</button></div></form></c:otherwise></c:choose></section></div></section></main></div><script src="${pageContext.request.contextPath}/frontend/js/intern-header.js?v=20261010-2"></script></body></html>
