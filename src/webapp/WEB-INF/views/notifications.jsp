<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Thông báo - IMS Portal</title><link rel="stylesheet" href="${pageContext.request.contextPath}/frontend/css/dashboard.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"><style>body{margin:0;background:#f5f8fc}.wrap{max-width:850px;margin:46px auto;padding:0 18px}.panel{background:#fff;border:1px solid #dce5f0;border-radius:15px;box-shadow:0 12px 32px rgba(25,53,86,.09);overflow:hidden}.head{display:flex;justify-content:space-between;align-items:center;padding:24px;border-bottom:1px solid #e3eaf3}.head h1{margin:0;color:#173d70;font-size:25px}.back{color:#315f96;text-decoration:none;font-weight:650}.item{display:flex;gap:14px;padding:18px 24px;border-bottom:1px solid #edf1f6;text-decoration:none;color:inherit}.item:hover{background:#f6f9fd}.item.unread{background:#edf5ff}.icon{width:38px;height:38px;display:grid;place-items:center;background:#e5effb;color:#2c5b91;border-radius:50%;flex:none}.item h2{margin:0 0 5px;color:#163a69;font-size:16px}.item p{margin:0;color:#61738b;font-size:14px;line-height:1.45}.time{margin-left:auto;white-space:nowrap;color:#8b9aad;font-size:12px}.empty{padding:50px;text-align:center;color:#74849a}</style></head><body><main class="wrap"><section class="panel"><div class="head"><h1><i class="fa-solid fa-bell"></i> Thông báo</h1><a class="back" href="${pageContext.request.contextPath}/home"><i class="fa-solid fa-arrow-left"></i> Quay lại</a></div><c:choose><c:when test="${empty notifications}"><div class="empty"><i class="fa-regular fa-bell-slash" style="font-size:28px"></i><p>Chưa có thông báo nào.</p></div></c:when><c:otherwise><c:forEach var="item" items="${notifications}"><a class="item ${item.read ? '' : 'unread'}" href="${pageContext.request.contextPath}${not empty item.targetUrl ? item.targetUrl : '/notifications'}"><div class="icon"><i class="fa-solid fa-bell"></i></div><div><h2>${item.title}</h2><p>${item.message}</p></div><time class="time">${item.createdAt}</time></a></c:forEach></c:otherwise></c:choose></section></main></body></html>
