<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Thông báo - IMS Portal</title><link rel="stylesheet" href="${pageContext.request.contextPath}/frontend/css/dashboard.css?v=20261015-2"><link rel="stylesheet" href="${pageContext.request.contextPath}/frontend/css/intern-work.css?v=20261015-2"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head><body><div class="layout">
<aside class="sidebar ${sessionScope.userRole == 'MENTOR' ? 'mentor-sidebar' : ''}"><div class="logo"><div class="logo-icon"><i class="fa-solid fa-bell"></i></div><div><h2>IMS Portal</h2><span><c:choose><c:when test="${sessionScope.userRole == 'HR'}">Phòng Nhân sự (HR)</c:when><c:when test="${sessionScope.userRole == 'MENTOR'}">Không gian Mentor</c:when><c:when test="${sessionScope.userRole == 'ADMIN'}">Quản trị hệ thống</c:when><c:otherwise>Không gian Thực tập sinh</c:otherwise></c:choose></span></div></div><nav class="menu"></nav></aside>
<main class="main"><header class="header"><div><strong><i class="fa-solid fa-bell"></i>&nbsp; Thông báo</strong></div><%@ include file="includes/hr-header-actions.jspf" %></header><section class="content work-page"><div class="page-title"><div><h1>Trung tâm thông báo</h1><p>Theo dõi các cập nhật quan trọng từ hệ thống.</p></div><c:if test="${unreadNotificationCount > 0}"><form method="post"><button class="btn-primary"><i class="fa-solid fa-check-double"></i> Đánh dấu tất cả đã đọc</button></form></c:if></div><section class="work-card"><div class="work-card-head"><div><h2>Tất cả thông báo</h2><p>${unreadNotificationCount} thông báo chưa đọc</p></div></div><c:choose><c:when test="${empty notifications}"><div class="empty-state"><i class="fa-regular fa-bell-slash fa-2x"></i><p>Bạn chưa có thông báo nào.</p></div></c:when><c:otherwise><div class="notification-list"><c:forEach var="item" items="${notifications}"><article class="notification-row ${item.read ? '' : 'unread'}"><div class="notification-icon"><i class="fa-solid fa-bell"></i></div><div class="notification-copy"><h3><c:out value="${item.title}"/></h3><p><c:out value="${item.message}"/></p></div><div class="notification-actions"><time>${item.createdAt}</time><form method="post"><input type="hidden" name="id" value="${item.id}"><input type="hidden" name="target" value="<c:out value='${empty item.targetUrl ? "/notifications" : item.targetUrl}'/>"><button class="open-notification" title="Mở thông báo"><i class="fa-solid fa-arrow-right"></i></button></form></div></article></c:forEach></div></c:otherwise></c:choose></section></section></main></div></body></html>
